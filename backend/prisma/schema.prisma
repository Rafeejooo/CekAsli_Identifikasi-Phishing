generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model UrlCheck {
  id          Int      @id @default(autoincrement())
  originalUrl String
  finalUrl    String?
  verdict     String
  score       Int
  createdAt   DateTime @default(now())
}

model OpenPhishEntry {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  createdAt DateTime @default(now())
}
